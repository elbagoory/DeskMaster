<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Styles.Resources>
    <ControlTheme x:Key="SegmentButtonTheme" TargetType="RadioButton">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource SubtleTextBrush}" />
      <Setter Property="Padding" Value="16,6" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center"
                              Foreground="{TemplateBinding Foreground}" />
          </Border>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:checked">
        <Setter Property="Background" Value="{DynamicResource CardBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
      </Style>
      <Style Selector="^:pointerover:not(:checked)">
        <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
      </Style>
    </ControlTheme>
  </Styles.Resources>

  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}" />
  </Style>

  <!-- Cards -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource CardBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="20" />
  </Style>

  <!-- Typography -->
  <Style Selector="TextBlock.title">
    <Setter Property="FontSize" Value="22" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.h2">
    <Setter Property="FontSize" Value="17" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.h3">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.subtle">
    <Setter Property="Foreground" Value="{DynamicResource SubtleTextBrush}" />
  </Style>
  <Style Selector="TextBlock.small">
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="TextBlock.big-number">
    <Setter Property="FontSize" Value="34" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="SelectableTextBlock.mono">
    <Setter Property="FlowDirection" Value="LeftToRight" />
  </Style>
  <Style Selector="TextBlock.mono">
    <Setter Property="FlowDirection" Value="LeftToRight" />
    <Setter Property="FontFamily" Value="Cascadia Mono,Consolas,Menlo,DejaVu Sans Mono,monospace" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <!-- Badges -->
  <Style Selector="Border.badge">
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="8,2" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="Background" Value="{DynamicResource MutedBadgeBrush}" />
  </Style>
  <Style Selector="Border.badge > TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Border.badge.safe">
    <Setter Property="Background" Value="{DynamicResource SafeBadgeBrush}" />
  </Style>
  <Style Selector="Border.badge.safe > TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource SafeTextBrush}" />
  </Style>
  <Style Selector="Border.badge.caution">
    <Setter Property="Background" Value="{DynamicResource CautionBadgeBrush}" />
  </Style>
  <Style Selector="Border.badge.caution > TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource CautionTextBrush}" />
  </Style>
  <Style Selector="Border.badge.info">
    <Setter Property="Background" Value="{DynamicResource InfoBadgeBrush}" />
  </Style>
  <Style Selector="Border.badge.info > TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource InfoTextBrush}" />
  </Style>

  <!-- Drive usage bars -->
  <Style Selector="ProgressBar.usage">
    <Setter Property="Height" Value="10" />
    <Setter Property="MinHeight" Value="10" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="Background" Value="{DynamicResource TrackBrush}" />
  </Style>
  <Style Selector="ProgressBar.usage.low">
    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
  </Style>
  <Style Selector="ProgressBar.thin">
    <Setter Property="Height" Value="6" />
    <Setter Property="MinHeight" Value="6" />
    <Setter Property="MinWidth" Value="40" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Background" Value="{DynamicResource TrackBrush}" />
  </Style>

  <!-- Mode switch -->
  <Style Selector="Border.segmented">
    <Setter Property="Background" Value="{DynamicResource TrackBrush}" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="Padding" Value="3" />
  </Style>
  <Style Selector="Border.segmented RadioButton">
    <Setter Property="Theme" Value="{StaticResource SegmentButtonTheme}" />
  </Style>


  <!-- List rows -->
  <Style Selector="ListBox.rows">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.rows ListBoxItem">
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Margin" Value="0,1" />
  </Style>

  <Style Selector="Button.link">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="4,2" />
    <Setter Property="Foreground" Value="{DynamicResource SystemControlHighlightAccentBrush}" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Border.card.banner">
    <Setter Property="Background" Value="{DynamicResource SuccessBannerBrush}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Border.card.banner.error">
    <Setter Property="Background" Value="{DynamicResource CautionBadgeBrush}" />
  </Style>

  <Style Selector="Button.danger /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Opacity" Value="0.9" />
  </Style>
  <Style Selector="Button.big">
    <Setter Property="Padding" Value="22,11" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="CornerRadius" Value="9" />
  </Style>

  <Style Selector="TabControl.pro TabItem">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="Padding" Value="14,0" />
  </Style>
</Styles>
