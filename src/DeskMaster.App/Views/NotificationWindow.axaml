<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="using:DeskMaster.App.Localization"
        x:Class="DeskMaster.App.Views.NotificationWindow"
        Width="380" SizeToContent="Height"
        CanResize="False" Topmost="True" ShowInTaskbar="False"
        WindowDecorations="None"
        Title="DeskMaster">
  <Border Classes="card" CornerRadius="10" Padding="16" BorderThickness="1">
    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto">
      <Image Source="/Assets/deskmaster-64.png" Width="32" Height="32" VerticalAlignment="Top" Margin="0,2,12,0" Grid.RowSpan="2" />
      <TextBlock x:Name="TitleText" Grid.Column="1" Classes="h3" TextWrapping="Wrap" />
      <TextBlock x:Name="MessageText" Grid.Column="1" Grid.Row="1" TextWrapping="Wrap" Margin="0,4,0,0" Classes="subtle" />
      <StackPanel Grid.Column="1" Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
        <Button x:Name="ActionButton" Classes="accent" />
        <Button x:Name="DismissButton" Content="{l:T 'Dismiss'}" />
      </StackPanel>
    </Grid>
  </Border>
</Window>
